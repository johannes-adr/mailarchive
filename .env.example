# copy to .env and adjust; every value can also be passed as a CLI flag (see --help)

MAILARCHIVE_HOST=imap.example.com
MAILARCHIVE_PORT=993
MAILARCHIVE_USER=me@example.com

# the password has no CLI flag on purpose (it would be visible in `ps`)
MAILARCHIVE_PASS=secret
# alternatively a command that prints it:
# MAILARCHIVE_PASS_CMD=pass show mail/example

# local Maildir root ("~" is expanded)
MAILARCHIVE_MAILDIR=~/Mail/example

# plain TCP, only for local/test servers
# MAILARCHIVE_TLS=false

# only sync these folders (comma separated; default: all)
# MAILARCHIVE_FOLDERS=INBOX,Sent

# seconds to wait in IDLE on INBOX before a full re-sync of all folders
MAILARCHIVE_IDLE_SECS=1500

# delete the local copy when a message disappears on the server.
# off by default: this is an archive, not a mirror
# MAILARCHIVE_EXPUNGE=true

# mirror flag changes (\Seen, \Flagged, ...) by renaming the local file
# MAILARCHIVE_SYNC_FLAGS=false
