{
  // "~" is expanded; every account gets a directory below it
  "maildir": "~/Mail",
  "idle_secs": 1500,
  // einmalig auf true setzen, wenn ein altes Archiv noch die Download-Zeit als Dateidatum
  // trägt; jeder Ordner wird genau einmal repariert (.dates_backfilled), danach kann die
  // Option wieder raus
  "backfill_dates": false,
  "accounts": [
    {
      "name": "web.de",
      "host": "imap.web.de",
      "port": 993,
      "user": "me@web.de",
      "pass_env": "WEBDE_PASS"
    },
    {
      "name": "gmail",
      "host": "imap.gmail.com",
      "user": "me@gmail.com",
      "pass_cmd": "pass show mail/gmail",
      "folders": ["INBOX", "[Gmail]/Sent Mail"],
      "expunge": false,
      "sync_flags": true
    }
  ],
  // shell commands run on events; %%mail_path%% is the (already quoted) path of the message
  "hooks": {
    "mail_received": "notmuch new && notify-send \"Neue Mail\" %%mail_path%%"
  }
}
